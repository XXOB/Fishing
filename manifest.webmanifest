{
  "id": "./",
  "name": "PetriKlar",
  "short_name": "PetriKlar",
  "description": "PetriKlar ist die Angel-App mit digitalem Fangbuch, Angelplätzen, Statistiken und verfügbaren amtlichen Wasser- und Pegeldaten.",
  "lang": "de-DE",
  "dir": "ltr",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#05070b",
  "theme_color": "#0a84ff",
  "categories": ["sports", "lifestyle", "utilities"],
  "icons": [
    {
      "src": "assets/icons/petriklar-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/petriklar-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/petriklar-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
